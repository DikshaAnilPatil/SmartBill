# SmartBill Backend Environment Configuration
PORT=5000
NODE_ENV=production

# MongoDB Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/smartbill?retryWrites=true&w=majority

# JWT Authentication Secret (Use a strong random string >= 32 characters)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Initial SuperAdmin Credentials (Required for first-time seed initialization)
SUPERADMIN_EMAIL=admin@smartbill.com
SUPERADMIN_PASSWORD=YourStrongSuperAdminPassword123!

# Razorpay Payment Gateway Integration
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# Email / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Smart Bill System" <no-reply@smartbill.com>

# Frontend Client URL & Allowed CORS Origins (comma-separated for production)
CLIENT_URL=https://app.smartbill.com
ALLOWED_ORIGINS=https://smartbill.com,https://app.smartbill.com,https://admin.smartbill.com,http://localhost:5173,http://localhost:5174,http://localhost:5175
